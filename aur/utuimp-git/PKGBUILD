# Maintainer: tphx37 <https://github.com/tphx37>
pkgname=utuimp-git
pkgver=4.0.4.r0.ge77c601
pkgrel=1
pkgdesc='Universal terminal user interface media player'
arch=('x86_64' 'aarch64')
url='https://github.com/tphx37/utuimp'
license=('GPL-3.0-or-later' 'MIT')
depends=('glibc' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-libav' 'fontconfig')
makedepends=('git' 'go>=1.26' 'gcc' 'pkgconf')
optdepends=('yt-dlp: YouTube Music and SoundCloud' 'ffmpeg: YouTube Music and SoundCloud' 'librespot: Spotify Premium')
provides=('utuimp')
conflicts=('utuimp' 'utuimp-bin')
source=('utuimp::git+https://github.com/tphx37/utuimp.git#branch=main')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/utuimp"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$srcdir/utuimp"
  export CGO_ENABLED=1
  export GOTOOLCHAIN=local
  go build -trimpath -buildmode=pie -mod=readonly \
    -ldflags "-linkmode=external -s -w -X github.com/tphx37/utuimp/internal/version.Version=$pkgver" -o utuimp .
}

package() {
  cd "$srcdir/utuimp"
  install -Dm755 utuimp "$pkgdir/usr/bin/utuimp"
  install -Dm644 flatpak/io.github.tphx37.utuimp.desktop "$pkgdir/usr/share/applications/io.github.tphx37.utuimp.desktop"
  install -Dm644 assets/logo.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.github.tphx37.utuimp.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
